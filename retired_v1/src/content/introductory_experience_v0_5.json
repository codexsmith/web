      "entryActions": ["begin", "choose-on-ramp", "open-atlas", "resume"],
      "steps": [
        {
          "id": "problem",
          "order": 0,
          "title": "The Fix",
          "headline": "Every consequential system draws a boundary.",
          "summary": "A system makes some states, people, and consequences visible while leaving others outside its model. Those exclusions do not disappear; they return as defect, burden, contradiction, risk, or harm.",
          "visualMode": "sequence",
          "layoutPreset": "single-consequence",
          "focusNodes": [],
          "newTerms": [],
          "transitionQuestion": "How should we begin examining such a system?",
          "institutionalTouchpoint": {
            "type": "promise",
            "sourcePaths": [
              "identity.mission.primary",
              "identity.vision.compact"
            ],
            "status": "copy-adjudication-required"
          }
        },
        {
          "id": "boundary-first",
          "order": 1,
          "title": "Boundary First",
          "headline": "Begin with what must remain true.",
          "summary": "Boundary First begins by declaring the operative boundary, naming the invariant, exposing where closure fails, and preserving a lawful path to repair.",
          "visualMode": "radial",
          "layoutPreset": "four-question-wheel",
          "focusNodes": ["boundary-first"],
          "newTerms": ["boundary", "invariant", "defect", "repair"],
          "transitionQuestion": "Where did this method come from?",
          "action": {
            "href": "/domain/boundary-first",
            "label": "Open the method record"
          },
          "institutionalTouchpoint": {
            "type": "mission-to-method",
            "sourcePaths": [
              "identity.mission.primary",
              "identity.mission.method"
            ],
            "status": "copy-adjudication-required"
          }
        },
        {
          "id": "roots",
          "order": 2,
          "title": "The Roots",
          "headline": "The work did not come from one field.",
          "summary": "Information, computation, practical mechanics, mathematics, physics, and scientific method provide distinct constraints. The lineage matters as context and discipline, not as borrowed authority.",
          "visualMode": "tree",
          "layoutPreset": "lineage-roots",
          "focusNodes": [],
          "virtualNodes": [
            "information",
            "computation",
            "practical-mechanics",
            "physics-lineage",
            "mathematics-lineage",
            "scientific-method"
