{
  "name": "boundary-first-labs-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run bridge:contracts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bridge:contracts": "node scripts/check_bridge_transition_behavior.mjs && node scripts/check_bridge_governance_contracts.mjs && node scripts/check_bridge_ledger_contracts.mjs && node scripts/check_bridge_ops_security_contracts.mjs",
    "contracts:check": "node scripts/check_v2_contracts.mjs && node scripts/check_version_route_contracts.mjs && node scripts/check_navigation_frame_contracts.mjs && node scripts/check_bounded_special_surfaces.mjs && node scripts/check_product_catalog_contracts.mjs && node scripts/check_public_interest_layout_contracts.mjs && npm run bridge:contracts",
    "runtime:check": "node scripts/check_v2_runtime.mjs",
    "verify": "npm run lint && npm run typecheck && npm run contracts:check && npm run build && npm run runtime:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
