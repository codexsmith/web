{
  "name": "boundary-first-labs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run content:build",
    "dev": "next dev",
    "prebuild": "npm run content:build && npm run architecture:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:build": "node scripts/build_public_content.mjs",
    "content:check": "node scripts/build_public_content.mjs --check",
    "architecture:check": "node scripts/check_outer_architecture.mjs",
    "acceptance:runtime": "node scripts/check_launch_readiness.mjs",
    "graph:build": "python scripts/build_graph_context.py",
    "graph:check": "python scripts/build_graph_context.py --check",
    "graph:dry-run": "python scripts/build_graph_context.py --dry-run",
    "graph:test": "python -m unittest scripts/test_build_graph_context.py",
    "test:ui": "vitest",
    "test:contracts": "vitest run tests/public-architecture.test.ts tests/product-landing-presentation.test.ts",
    "ui:normalize": "python scripts/opacity_purge.py && python scripts/replace_email.py",
    "ui:check": "python scripts/check_ui_stabilization.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.42.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
