{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundaryfirstlabs.example/schemas/historical-lineage-v0.1.json",
  "title": "Boundary First Labs Historical Lineage Relation",
  "type": "object",
  "required": [
    "id",
    "entityType",
    "target",
    "source",
    "lineageType",
    "contributionSummary",
    "whyItMattersHere",
    "localUse",
    "differenceOrBoundary",
    "nonClaims",
    "evidenceStatus",
    "citationStatus",
    "publicCopyStatus",
    "sourceBasis"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lineage-[a-z0-9-]+$"
    },
    "entityType": {
      "const": "lineage-relation"
    },
    "target": {
      "type": "string"
    },
    "targetLabel": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person-work",
            "institution-or-document-work",
            "field-tradition",
            "method-tradition",
            "experiment",
            "problem"
          ]
        },
        "authorOrInstitution": {
          "type": "string"
        },
        "work": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "year": {}
      },
      "additionalProperties": true
    },
    "lineageType": {
      "enum": [
        "documented-direct-influence",
        "foundational-formalism",
        "foundational-research-tradition",
        "methodological-lineage",
        "historical-precedent",
        "critical-counterpoint",
        "neighboring-research-lineage",
        "shared-problem",
        "independent-convergence",
        "comparative-reference"
      ]
    },
    "contributionSummary": {
      "type": "string",
      "minLength": 1
    },
    "whyItMattersHere": {
      "type": "string",
      "minLength": 1
    },
    "localUse": {
      "type": "string",
      "minLength": 1
    },
    "differenceOrBoundary": {
      "type": "string",
      "minLength": 1
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidenceStatus": {
      "enum": [
        "present-in-canonical-node-history",
        "corpus-supported-editorial-candidate",
        "user-directed-editorial-candidate",
        "disciplinary-foundation",
        "editorial-comparison",
        "proposed-for-review"
      ]
    },
    "citationStatus": {
      "enum": [
        "verified",
        "work-verified-page-citation-needed",
        "edition-verification-required",
        "source-and-edition-verification-required",
        "proposed-for-review"
      ]
    },
    "publicCopyStatus": {
      "enum": [
        "candidate",
        "reviewed",
        "approved",
        "withheld"
      ]
    },
    "sourceBasis": {
      "type": "string"
    },
    "sourceAnchors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}