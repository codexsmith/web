          "transitionQuestion": "What aspects of this object must a theory explain?"
        },
        {
          "id": "boundary-theory",
          "order": 7,
          "title": "Boundary Theory",
          "headline": "Boundary Theory studies the structure and transformation of Distinction Spaces.",
          "visualMode": "radial",
          "layoutPreset": "faceted-object",
          "focusNodes": ["boundary-theory", "distinction-space"],
