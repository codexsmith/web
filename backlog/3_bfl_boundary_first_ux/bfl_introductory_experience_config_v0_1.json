{
  "schemaVersion": "0.1.0",
  "status": "implementation-guidance-draft",
  "defaultExperience": "first-passage",
  "viewModes": {
    "sequence": {
      "description": "A resumable guided camera path through curated graph scenes.",
      "supports": ["next", "previous", "skip", "nodeDive", "resume"],
      "preserveState": true
    },
    "radial": {
      "description": "A focused node or object surrounded by a curated conceptual neighborhood.",
      "maxPrimaryNeighbors": 7,
      "stablePositions": true
    },
    "tree": {
      "description": "A hierarchy or lineage projection using selected primary edge types.",
      "defaultEdgeTypes": ["contains", "definedWithin", "grounds", "appliedThrough", "stewards"]
    },
    "node": {
      "description": "The canonical deep record for one node.",
      "sections": ["overview", "facets", "takeaways", "claims", "documents", "programs", "history", "relations", "pathways"]
    },
    "pathway": {
      "description": "A reader-intent route through selected nodes and sequence scenes.",
      "preserveBranchChoice": true
    },
    "atlas": {
      "description": "The complete graph with search, filters, focus, and pathway emphasis.",
      "filters": ["role", "layer", "maturity", "pathway", "relationType"]
    }
  },
  "experiences": [
    {
