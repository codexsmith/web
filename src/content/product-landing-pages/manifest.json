  "collections": {
    "active": "Current public-facing product, method, practitioner, service, and research landing objects eligible for a future public routing decision.",
    "bridge": "Recipient-, institution-, community-, or target-class-specific collaboration pages. These may be routable by direct URL later but must not enter navigation or sitemap discovery solely because they exist.",
    "legacy-recovered": "Previously developed landing-page work preserved for migration. Terminology or hierarchy may be superseded; no public route should be generated until reconciled with current canon.",
    "reconciliation": "Current concept with unresolved overlap or naming against another portfolio object. Preserve content but hold routing until adjudicated."
  },
  "routingPolicy": {
    "implemented": false,
    "publicRule": "visibility=public and routingEligibility=public-candidate may be considered by the future router; neither field alone creates a route.",
    "unlistedRule": "visibility=unlisted must remain absent from primary navigation and sitemap/indexing surfaces unless an explicit later policy overrides that behavior.",
    "privateRule": "visibility=private or routingEligibility=hold must never be exposed by automatic content discovery.",
    "relationshipRule": "A named bridge with relationshipStatus=exploratory-no-affiliation or target-class-no-affiliation must never be rendered in language that implies endorsement, partnership, sponsorship, review, or institutional adoption.",
    "notes": "UI, route resolution, navigation, sitemap behavior, robots behavior, canonical URLs, relationship-status enforcement, and private/unlisted enforcement remain separate implementation work."
  }
}
