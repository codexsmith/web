  "collections": {
    "active": "Current public-facing product, method, practitioner, service, and research landing objects eligible for a future public route.",
    "bridge": "Recipient-, institution-, community-, or target-class-specific collaboration pages. Direct-link routing is allowed only when the renderer route is activated; bridges never enter primary navigation or sitemap discovery automatically.",
    "legacy-recovered": "Previously developed landing-page work preserved for migration. Terminology or hierarchy may be superseded; these records are blocked from public routing until reconciled.",
    "reconciliation": "Current concept with unresolved overlap or naming against another portfolio object. Preserve content but block public routing until adjudicated."
  },
  "routingPolicy": {
    "implemented": true,
    "rulesImplemented": true,
    "routesImplemented": false,
    "rendererImplemented": false,
    "publicRule": "visibility=public and routingEligibility=public-candidate is the only combination eligible for public routing, indexing, navigation, and sitemap inclusion after route activation.",
    "unlistedRule": "visibility=unlisted and routingEligibility=unlisted-only permits direct-link routing after route activation but requires noindex/nofollow metadata and exclusion from primary navigation and sitemap discovery.",
    "privateRule": "visibility=private or routingEligibility=hold is blocked from automatic routing and discovery and must resolve as unavailable if presented to the public router.",
    "relationshipRule": "Every bridge must declare relationshipStatus. exploratory-no-affiliation and target-class-no-affiliation must never render language implying endorsement, partnership, sponsorship, review, or adoption; historical-project-no-current-affiliation may describe documented historical work but must not imply a current relationship.",
    "activationRule": "No landing page may enter the sitemap merely because policy marks it eligible. routesImplemented and a renderer route must be active before public landing URLs are emitted.",
    "notes": "The manifest and src/lib/product-landing-routing.ts now define executable route/visibility decisions. UI rendering, canonical metadata extraction from heterogeneous content objects, and physical catch-all route activation remain the next implementation layer."
  }
}
