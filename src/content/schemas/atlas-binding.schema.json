{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundaryfirst.org/schemas/atlas-binding.schema.json",
  "title": "Boundary First Atlas binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingProtocol", "projection", "validation"],
  "properties": {
    "schemaVersion": {
      "const": "boundary-first.binding.atlas.v1"
    },
    "bindingProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "status", "invariant"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["draft", "review", "approved", "superseded"]
        },
        "invariant": { "type": "string", "minLength": 1 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "rootNodeId",
        "contextNodeId",
        "eyebrow",
        "title",
        "introduction",
        "branches"
      ],
      "properties": {
        "pattern": { "const": "theory-centered-cluster-tree" },
        "rootNodeId": { "type": "string", "minLength": 1 },
        "contextNodeId": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "introduction": { "type": "string", "minLength": 1 },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "layer",
              "angleDegrees",
              "nodeIds"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "layer": { "type": "string", "minLength": 1 },
              "angleDegrees": { "type": "number" },
              "nodeIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireCompleteCanonicalCoverage",
        "requireUniqueBranchMembership",
        "accessibilityConstraints"
      ],
      "properties": {
        "requireCompleteCanonicalCoverage": { "const": true },
        "requireUniqueBranchMembership": { "const": true },
        "accessibilityConstraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
