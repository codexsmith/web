NEXT_PUBLIC_SITE_URL=https://boundaryfirstlabs.com

# Internal Bridge operator surface. Configure these only in server environments.
BFL_BRIDGE_OPS_PASSWORD=
BFL_BRIDGE_OPS_ACTOR=operator
BFL_BRIDGE_GITHUB_TOKEN=
BFL_BRIDGE_GITHUB_REPOSITORY=codexsmith/web
BFL_BRIDGE_GITHUB_BRANCH=main


# Public inquiry intake. Server-only; never expose these with NEXT_PUBLIC_.
# The receiver should accept the JSON payload produced by /api/inquiry.
BFL_INQUIRY_WEBHOOK_URL=
BFL_INQUIRY_WEBHOOK_TOKEN=


# Governed Open Lab intake. Server-only; never expose these with NEXT_PUBLIC_.
# Public collection remains closed unless every value below is present and valid.
BFL_OPEN_LAB_WEBHOOK_URL=
BFL_OPEN_LAB_WEBHOOK_TOKEN=
BFL_OPEN_LAB_POLICY_VERSION=
# Positive integer number of days.
BFL_OPEN_LAB_RETENTION_DAYS=
# Required exact acknowledgement for the currently pinned Lab source revision:
# reviewed:1dbd3f5b53e55c8feff5230836ce11dc928cba69
BFL_OPEN_LAB_GOVERNANCE_ACK=


# Website v3 release gate.
# Keep false while /v3 is a preview surface. Set true only when v3 is approved for indexing.
BFL_V3_INDEXABLE=false
